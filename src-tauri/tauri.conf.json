{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Surtitle",
  "version": "0.1.0",
  "identifier": "app.surtitle.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Surtitle",
        "width": 1440,
        "height": 940,
        "minWidth": 1024,
        "minHeight": 700,
        "backgroundColor": "#101416"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "category": "Education",
    "shortDescription": "Learn languages from your media",
    "license": "GPL-3.0-or-later",
    "resources": {
      "resources/native/": "native/",
      "resources/notices/": "notices/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Japanese",
          "English"
        ],
        "displayLanguageSelector": true,
        "installerHooks": "../native/windows-prerequisite.nsh",
        "template": "../native/installer.nsi"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": false
      }
    },
    "useLocalToolsDir": true
  }
}
