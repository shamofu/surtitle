+// Private Surtitle runtime extension, deliberately outside the installed API.
+// Success transfers exactly one IDXGISwapChain1 COM reference to the caller.
+MPV_EXPORT int mpv_surtitle_acquire_d3d11_swapchain(struct mpv_handle *ctx,
+                                                 void **out);
