 #include "command.h"
 #include "core.h"
@@ -1486,6 +1487,39 @@
     };
     run_locked(ctx, getproperty_fn, &req);
     return req.status;
+}
+
+struct surtitle_swapchain_request {
+    struct MPContext *mpctx;
+    void *swapchain;
+};
+
+static void surtitle_acquire_swapchain(void *data)
+{
+    struct surtitle_swapchain_request *req = data;
+    // The core dispatch lock keeps video_out and its published swapchain alive
+    // until QueryInterface owns a reference. Never release this lock between
+    // reading the pointer and acquiring ownership.
+    if (req->mpctx->video_out)
+        req->swapchain = vo_acquire_d3d11_swapchain(req->mpctx->video_out);
+}
+
+int mpv_surtitle_acquire_d3d11_swapchain(mpv_handle *ctx, void **out)
+{
+    if (!out)
+        return MPV_ERROR_INVALID_PARAMETER;
+    *out = NULL;
+    if (!ctx)
+        return MPV_ERROR_INVALID_PARAMETER;
+    if (!ctx->mpctx->initialized)
+        return MPV_ERROR_UNINITIALIZED;
+
+    struct surtitle_swapchain_request req = { .mpctx = ctx->mpctx };
+    run_locked(ctx, surtitle_acquire_swapchain, &req);
+    if (!req.swapchain)
+        return MPV_ERROR_PROPERTY_UNAVAILABLE;
+    *out = req.swapchain;
+    return MPV_ERROR_SUCCESS;
 }
 
