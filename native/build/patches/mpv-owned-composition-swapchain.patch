+void *vo_acquire_d3d11_swapchain(struct vo *vo)
+{
+#if HAVE_D3D11
+    // In this pinned backend, initialization publishes display_swapchain before
+    // vo_create's init barrier returns. Only teardown clears/releases it, and
+    // vo_destroy is called under the playback core lock held by our caller.
+    // ResizeBuffers preserves the COM object. Recheck these invariants whenever
+    // updating mpv: reading a borrowed pointer and AddRef'ing later is unsafe.
+    // DXGI explicitly permits concurrent QueryInterface/AddRef/Release. Avoid
+    // VO dispatch here: it can wait for rendering/Present and stall the UI.
+    IUnknown *swapchain = vo->display_swapchain;
+    void *owned = NULL;
+    if (swapchain) {
+        HRESULT hr = swapchain->lpVtbl->QueryInterface(
+            swapchain, &IID_IDXGISwapChain1, &owned);
+        if (FAILED(hr))
+            owned = NULL;
+    }
+    return owned;
+#else
+    return NULL;
+#endif
+}
